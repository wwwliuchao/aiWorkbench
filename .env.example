# MySQL 服务地址；本机数据库使用 127.0.0.1，容器部署时通常填写数据库服务名
MYSQL_HOST=127.0.0.1
# MySQL 服务端口，默认 3306
MYSQL_PORT=3306
# 应用使用的数据库名称
MYSQL_DATABASE=asset_portal
# 数据库登录用户名
MYSQL_USER=asset_portal_user
# 数据库登录密码（敏感信息，请仅在本地或部署平台配置，禁止提交真实值）
MYSQL_PASSWORD=

# 应用对外访问的完整地址，用于生成跳转和回调 URL；不要以斜杠结尾
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 应用部署在子路径时填写，例如 /ai-workbench；部署在域名根路径时留空
NEXT_PUBLIC_BASE_PATH=
# Session Cookie 是否仅允许通过 HTTPS 发送；生产 HTTPS 环境建议设为 true，本地 HTTP 可设为 false
AUTH_COOKIE_SECURE=false
# 飞书应用 App ID，用于发起飞书 OAuth 登录
FEISHU_APP_ID=
# 飞书应用 App Secret（敏感信息，禁止提交真实值）
FEISHU_APP_SECRET=
# 飞书 OAuth 回调地址，必须与飞书开放平台中登记的重定向 URL 完全一致
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
# RPA 平台 API 的 App Key，用于调用任务启动接口（敏感凭证）
RPA_API_APP_KEY=
# RPA 平台 API 的 App Secret，用于调用任务启动接口（敏感凭证）
RPA_API_APP_SECRET=
# RestCloud 通知接口的 App Key，会作为 appkey 查询参数发送（敏感凭证）
RPA_RESTCLOUD_APP_KEY=
# RPA 启动成功后接收异步通知的 RestCloud 接口地址；服务端会向该地址发送任务 UUID
RPA_RESTCLOUD_NOTIFY_URL=
